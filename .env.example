# Copy to .env and fill in real values:  cp .env.example .env
# Generate secrets with e.g.:  openssl rand -base64 48

# HMAC key for signing JWTs. Required, at least 32 characters; the gateway refuses to start otherwise.
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional overrides
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# APP_SHORT_URL_PREFIX=http://localhost:8080/api/v1/
